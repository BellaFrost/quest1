# bot.py
import asyncio
import logging
import os

from aiogram import Bot, Dispatcher
from aiogram.filters import CommandStart
from aiogram.types import Message

# ──────────────────────────────────────────────
# Настройки (меняй здесь)
# ──────────────────────────────────────────────

# Секретный код (лучше хранить в переменных окружения, но для простоты оставим здесь)
SECRET_CODE = "secret2026"               # ← твой код

# Ссылка, которую отдаём при правильном коде
# Примеры:
#   - Google Drive (прямая ссылка): https://drive.google.com/uc?export=download&id=ФАЙЛ_ID
#   - Яндекс.Диск: публичная ссылка вида https://disk.yandex.ru/d/xxxxxxx
#   - Mega.nz, DropMeFiles, File.io и т.п.
SECRET_LINK = "https://example.com/your-secret-file.zip"

# Текст сообщения с ссылкой
MESSAGE_TEXT = (
    "Вот твоя секретная ссылка:\n"
    f"{SECRET_LINK}\n\n"
    "Скачай быстро — ссылка может быть временной или с ограничением по скачиваниям."
)

# Опционально: список разрешённых user_id (если хочешь ограничить доступ)
ALLOWED_USERS = {123456789, 987654321}   # ← пустой список = всем разрешено

# ──────────────────────────────────────────────

logging.basicConfig(level=logging.INFO)

TOKEN = os.getenv("TOKEN")
if not TOKEN:
    raise ValueError("Переменная окружения TOKEN не задана!")

bot = Bot(token=TOKEN)
dp = Dispatcher()


@dp.message(CommandStart())
async def cmd_start(message: Message):
    await message.answer(
        "Привет! 👋\n"
        "Введи секретный код, чтобы получить ссылку на файл."
    )


@dp.message()
async def check_code(message: Message):
    user_id = message.from_user.id
    text = message.text.strip()

    if text != SECRET_CODE:
        await message.answer("Неверный код 😕")
        return

    # Проверка на разрешённых пользователей (если список не пустой)
    if ALLOWED_USERS and user_id not in ALLOWED_USERS:
        await message.answer("Доступ запрещён.")
        # Можно добавить лог админу:
        # await bot.send_message(твой_id, f"Попытка доступа: {user_id}")
        return

    try:
        await message.answer(MESSAGE_TEXT, disable_web_page_preview=False)
        # disable_web_page_preview=False → Telegram покажет превью, если ссылка поддерживает
    except Exception as e:
        logging.error(f"Ошибка при отправке ссылки пользователю {user_id}: {e}")
        await message.answer("Не удалось отправить ссылку. Попробуй позже.")


async def main():
    await bot.delete_webhook(drop_pending_updates=True)
    await dp.start_polling(bot)


if __name__ == "__main__":
    asyncio.run(main())
